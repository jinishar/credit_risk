# Dataset - never commit, mounted as a Docker volume instead
/data/

# Trained artifacts - the champion model + preprocessor + derived JSON are
# committed so the app boots on a fresh clone / Streamlit Cloud without a
# training run. Larger throwaway artifacts stay ignored.
models/*.pkl
models/*.txt
models/shap_background.joblib

# Env / secrets
.env

# Python
__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# Notebooks
.ipynb_checkpoints/
# notebooks/figures/*.png are committed so the EDA charts show on GitHub without a run

# OS / editor
.DS_Store
.vscode/
.idea/
