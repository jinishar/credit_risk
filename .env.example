# Google Gemini API key for the talk-to-data chatbot and explanation narration.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model used for NL->SQL generation and result narration.
# Check https://ai.google.dev/gemini-api/docs/models for the current model list/names.
GEMINI_MODEL=gemini-3.6-flash

# Paths (defaults work both locally and inside Docker).
DATA_DIR=data
MODELS_DIR=models

# Risk band thresholds on predicted default probability.
RISK_LOW_THRESHOLD=0.2
RISK_HIGH_THRESHOLD=0.5

# Number of synthetic rows to generate when no real Kaggle CSV is present in DATA_DIR.
N_SYNTHETIC_ROWS=50000

# Streamlit server port.
APP_PORT=8501

LOG_LEVEL=INFO
